{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "headline",
    "experience"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "org",
          "start"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "degree",
          "school"
        ],
        "properties": {
          "degree": {
            "type": "string"
          },
          "school": {
            "type": "string"
          },
          "year": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "youtubeId": {
            "type": "string"
          },
          "featured": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "If set, the project gets a page at /projects/<slug>/ and its card links there."
          },
          "summary": {
            "type": "string",
            "description": "One-line lede on the project page; falls back to description."
          },
          "status": {
            "type": "string",
            "description": "Short label shown on the page, e.g. 'In progress', 'Published'."
          },
          "body": {
            "type": "string",
            "description": "Page text; blank line = new paragraph."
          },
          "team": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "image",
                "alt"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "description": "File name in src/assets/projects/<slug>/"
                },
                "alt": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                }
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "year": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "cover": {
                  "type": "string",
                  "description": "File name in src/assets/projects/<slug>/"
                }
              }
            }
          },
          "thesis": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "description": "e.g. 'coming soon'"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "level"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": "string"
          }
        }
      }
    },
    "publications_summary": {
      "type": "string"
    },
    "volunteering": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
