---
import cv from '../data/cv';
const year = new Date().getFullYear();
const label = (l: string) => (l === 'Behance' ? 'Behance (volunteer design work)' : l);
---
<footer class="site-footer">
  <div class="container row">
    <p>&copy; {year} {cv.name.split(',')[0]}</p>
    <ul>
      {cv.links.map((l) => <li><a href={l.url} rel="noopener">{label(l.label)}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2); align-items: center; border-top: var(--rule); padding-block: var(--s-3); }
  p { margin: 0; font-size: var(--fs-meta); color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: var(--s-3); list-style: none; margin: 0; padding: 0; min-width: 0; }
  li { min-width: 0; overflow-wrap: anywhere; }
  a { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-meta); color: var(--indigo); }
  a:hover { color: var(--ink); }
</style>
